# =========================
# НОВОЕ: быстрый расчёт S_N для всех N сразу + график сходимости
# =========================
def S_series_upto_Nmax(N_max, y0=b, z0=0.0):
    """
    Возвращает массив S_values_all длины N_max,
    где S_values_all[i] = S_{i+1}(y0, z0).
    """
    n_loc = np.arange(1, N_max + 1)
    n_half_loc = n_loc - 0.5

    gamma_n_loc = np.sqrt((n_loc * np.pi / b)**2 - k**2)
    gamma_n_half_loc = np.sqrt((n_half_loc * np.pi / b)**2 - k**2)

    # K_plus(k) считаем один раз
    Kk_loc = K_plus(k)

    # K_plus(1j*gamma) считаем один раз для всех мод до N_max
    K_gamma_loc = np.array([K_plus(1j * g) for g in gamma_n_loc])
    K_gamma_half_loc = np.array([K_plus(1j * g) for g in gamma_n_half_loc])

    P_n_loc = (-1)**(n_loc + 1) * (1j * k) / (gamma_n_loc * Kk_loc * K_gamma_loc)
    P_n_half_loc = (-1)**(n_loc + 1) * (1j * k * K_gamma_half_loc) / (
        n_half_loc * np.pi * gamma_n_half_loc * Kk_loc
    )

    term_half = (
        P_n_half_loc
        * np.cos(n_half_loc * np.pi * y0 / b + 0j)
        * np.exp(-gamma_n_half_loc * np.abs(z0))
    )
    term_int = (
        P_n_loc
        * np.cos(n_loc * np.pi * y0 / b + 0j)
        * np.exp(-gamma_n_loc * np.abs(z0))
    )

    # Префиксные суммы: сразу все S_N
    terms = term_half + term_int
    S_values_all = np.cumsum(terms)

    return S_values_all


# Пример использования
N_max = 300
y0_fast = b
z0_fast = 0.0

S_values_fast = S_series_upto_Nmax(N_max, y0=y0_fast, z0=z0_fast)
N_values_fast = np.arange(1, N_max + 1)

# 1) График S_N
plt.figure(figsize=(8, 4))
plt.plot(N_values_fast, np.abs(S_values_fast), label='|S_N|')
plt.plot(N_values_fast, S_values_fast.real, '--', label='Re(S_N)', alpha=0.8)
plt.plot(N_values_fast, S_values_fast.imag, ':', label='Im(S_N)', alpha=0.8)
plt.xlabel('N (число слагаемых)')
plt.ylabel('S_N(y0, z0)')
plt.grid(True)
plt.legend()
plt.show()

# 2) График сходимости к S_{N_max}
S_ref = S_values_fast[-1]
conv_err = np.abs(S_values_fast - S_ref)

plt.figure(figsize=(8, 4))
plt.semilogy(N_values_fast, conv_err, label='|S_N - S_{N_max}|')
plt.xlabel('N (число слагаемых)')
plt.ylabel('Ошибка сходимости')
plt.grid(True, which='both')
plt.legend()
plt.show()