# =========================
# НОВОЕ: S_N как функция числа слагаемых N
# =========================
def S_of_N(N_terms, y0=b, z0=0.0):
    n_loc = np.arange(1, N_terms + 1)
    n_half_loc = n_loc - 0.5

    gamma_n_loc = np.sqrt((n_loc * np.pi / b)**2 - k**2)
    gamma_n_half_loc = np.sqrt((n_half_loc * np.pi / b)**2 - k**2)

    Kk_loc = K_plus(k)
    K_gamma_loc = np.array([K_plus(1j * g) for g in gamma_n_loc])
    K_gamma_half_loc = np.array([K_plus(1j * g) for g in gamma_n_half_loc])

    P_n_loc = (-1)**(n_loc + 1) * (1j * k) / (gamma_n_loc * Kk_loc * K_gamma_loc)
    P_n_half_loc = (-1)**(n_loc + 1) * (1j * k * K_gamma_half_loc) / (
        n_half_loc * np.pi * gamma_n_half_loc * Kk_loc
    )

    term_half = P_n_half_loc * np.cos(n_half_loc * np.pi * y0 / b + 0j) * np.exp(-gamma_n_half_loc * np.abs(z0))
    term_int = P_n_loc * np.cos(n_loc * np.pi * y0 / b + 0j) * np.exp(-gamma_n_loc * np.abs(z0))

    return np.sum(term_half + term_int)


# Пример: зависимость |S_N(y0, z0)| от N
N_values = np.arange(1, 301)
y0 = b
z0 = 0.0

S_values = np.array([S_of_N(Ni, y0=y0, z0=z0) for Ni in N_values])

plt.figure(figsize=(8, 4))
plt.plot(N_values, np.abs(S_values), label='|S_N|')
plt.plot(N_values, S_values.real, '--', label='Re(S_N)', alpha=0.8)
plt.plot(N_values, S_values.imag, ':', label='Im(S_N)', alpha=0.8)
plt.xlabel('N_S (число слагаемых)')
plt.ylabel('S(y0, z0)')
plt.grid(True)
plt.legend()
plt.show()


